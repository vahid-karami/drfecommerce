# Files NOT uploaded by `liara deploy`.
# Like .gitignore, except frontend/dist (the built React app) IS uploaded.

.git/
venv/
.venv/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
.env
.vscode/
.idea/
.claude/

# Local data (production uses Liara disks)
db.sqlite3
**/db.sqlite3
media/
drfecommerce/media/
database/
staticfiles/

# Frontend sources/tooling are not needed at runtime
frontend/node_modules/
frontend/.vite/
frontend/src/
frontend/public/
frontend/*.local
